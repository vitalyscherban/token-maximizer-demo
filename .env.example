# Provider: "mock" runs fully offline and is the default for client demos.
TOKENMAX_PROVIDER=mock

# Set to "openai" to talk to a real endpoint.
# TOKENMAX_PROVIDER=openai
# TOKENMAX_API_KEY=sk-...
# TOKENMAX_BASE_URL=https://api.openai.com/v1
# TOKENMAX_MODEL=gpt-4o-mini

# Token budget knobs (per request)
TOKENMAX_CONTEXT_WINDOW=8192
TOKENMAX_RESERVED_OUTPUT=512
TOKENMAX_COMPACTION_TRIGGER=0.6
TOKENMAX_PROTECTED_RECENT_TURNS=4
TOKENMAX_TOOL_RESULT_MAX_TOKENS=256
TOKENMAX_CACHE_TTL_SECONDS=900

# Technique switches - flip one to false and re-run to price that technique.
# See docs/CONFIGURATION.md.
TOKENMAX_ENABLE_COMPACTION=true
TOKENMAX_ENABLE_PRUNING=true
TOKENMAX_ENABLE_TOOL_ROUTING=true
TOKENMAX_ENABLE_SCHEMA_SLIMMING=true
TOKENMAX_ENABLE_RESULT_TRUNCATION=true
TOKENMAX_ENABLE_CACHE=true
